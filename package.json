{
  "name": "modal-mitra-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:ui && wrangler deploy",
    "deploy:all": "tsx scripts/deploy-all.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute modal_mitra_db --local --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute modal_mitra_db --remote --file=src/db/schema.sql",
    "gen-data": "tsx scripts/gen-data.ts",
    "chunk-kb": "tsx scripts/chunk-kb.ts",
    "seed:remote": "wrangler d1 execute modal_mitra_db --remote --file=data/synthetic/seed.sql",
    "demo:reset-restru": "wrangler d1 execute modal_mitra_db --remote --command \"INSERT INTO record_versions (record_type, record_id, status, changed_by, note) SELECT 'restructuring_request', restru_id, 'rejected', 'system', 'demo reset: artefak uji/eval ditutup' FROM restructuring_requests WHERE status IN ('pending_cs_approval','approved_once','submitted','under_review'); UPDATE restructuring_requests SET status='rejected' WHERE status IN ('pending_cs_approval','approved_once','submitted','under_review')\"",
    "ingest:remote": "tsx scripts/run-ingest.ts",
    "eval": "tsx scripts/run-eval.ts",
    "latency": "tsx scripts/measure-latency.ts",
    "eval:langfuse:push": "tsx scripts/push-golden-to-langfuse.ts",
    "eval:langfuse:run": "tsx scripts/run-langfuse-eval.ts",
    "test:extras": "vitest run tests/extras --pool=threads --poolOptions.threads.maxThreads=2 --poolOptions.threads.minThreads=1",
    "eval:extras": "tsx scripts/run-extras-eval.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251020.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "promptfoo": "^0.100.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1",
    "wrangler": "^3.90.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.160",
    "@cloudflare/ai-chat": "^0.12.2",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "agents": "^0.31.0",
    "ai": "^7.0.156",
    "hono": "^4.6.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workers-ai-provider": "^4.0.1",
    "zod": "^3.23.8"
  }
}
